//
// Flow control
//

num_vcs     = 2;
vc_buf_size = 4;
rc_buf_size = 16;

wait_for_tail_credit = 0;

//watch_out = /home/siudya/booksim2/watch.log;
//watch_flits = {273};
latency_thres = 512.0;

vc_allocator = islip; 
sw_allocator = islip;
alloc_iters  = 2;

credit_delay   = 1;
routing_delay  = 0;
vc_alloc_delay = 1;
sw_alloc_delay = 1;
st_final_delay = 1;
speculative = 1;
d2d_latency = 32;

input_speedup     = 1;
output_speedup    = 1;
internal_speedup  = 1.0;

//
// Traffic
//

sim_type = latency;

warmup_periods = 3;

sample_period = 100000;

max_samples = 10;

packet_size = {1,4};
packet_size_rate = {1,1};
injection_rate_uses_flits = 1;
traffic = uniform;
classes = 1;
//seed = time;

sim_count          = 1;

//topoogy

topology = chiplet_twin;
k  = 4;
n  = 2;
//
// Routing


routing_function = dor_vda;

use_read_write = 0;

injection_rate = 0.007;


